{
  "extends": "@jrmoulckers/tsconfig/next.json",
  "compilerOptions": {
    /* Product-specific: Next transpiles CJS interop for us and the repo has
       type-checked JS config/scripts. */
    "esModuleInterop": true,
    "checkJs": true,

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "**/*.cjs", "**/*.js", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "src/app/sw.ts", "public"]
}
