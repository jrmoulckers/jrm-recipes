{
  "name": "heirloom",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "prepare:ocr": "node scripts/copy-ocr-assets.mjs && node scripts/copy-dietary-runtime-assets.mjs",
    "predev": "pnpm prepare:ocr",
    "dev": "next dev",
    "prebuild": "pnpm prepare:ocr",
    "build": "next build --webpack",
    "analyze": "node scripts/analyze.mjs",
    "bundle:route-chunks": "node scripts/route-chunk-attribution.mjs",
    "precheck:bundle": "pnpm prepare:ocr",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:e2e-skips": "node scripts/check-e2e-skips.mjs",
    "vendor:check": "node scripts/vendor-configs.mjs --check",
    "ci:build": "pnpm check:bundle && node scripts/package-ci-build.mjs",
    "lhci": "node scripts/lighthouse.mjs",
    "prevercel-build": "pnpm prepare:ocr",
    "vercel-build": "node scripts/preflight-env.mjs && node scripts/migrate.mjs && next build --webpack",
    "start": "next start",
    "prepreview": "pnpm prepare:ocr",
    "preview": "next build --webpack && next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,css,md,mdx}\" --cache",
    "check": "pnpm run lint && pnpm run typecheck",
    "i18n:validate": "node scripts/i18n-validate.mjs",
    "i18n:english-leak": "node scripts/i18n-english-leak.mjs",
    "i18n:rich-tags": "node scripts/i18n-rich-tags.mjs",
    "i18n:route-scope": "node scripts/i18n-route-scope.mjs",
    "a11y:alt-audit": "node scripts/alt-audit.mjs",
    "copy:check": "pnpm run i18n:validate && pnpm run i18n:english-leak && pnpm run i18n:rich-tags && pnpm run i18n:route-scope -- --check && pnpm run a11y:alt-audit",
    "i18n:pseudo": "node scripts/i18n-pseudo.mjs",
    "audit:suppressions": "node scripts/check-audit-suppressions.mjs",
    "audit:ci": "pnpm audit:suppressions && pnpm audit --audit-level=high",
    "test": "vitest run",
    "test:bug": "node scripts/bug-loop.mjs unit",
    "test:e2e:bug": "node scripts/bug-loop.mjs e2e",
    "bug:classify": "node scripts/bug-loop.mjs classify",
    "bug:check": "node scripts/bug-loop.mjs check",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check-fks": "tsx scripts/check-fk-actions.ts",
    "db:check-triggers": "tsx scripts/check-db-triggers.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:seed:e2e": "tsx src/server/db/seed-e2e.ts",
    "db:seed-food-graph": "tsx scripts/seed-food-graph.ts",
    "verify:food-portions": "tsx scripts/verify-food-portions-usda.ts",
    "db:backfill-tags": "tsx scripts/backfill-tag-taxonomy.ts",
    "db:backfill-dietary": "tsx scripts/backfill-dietary-tags.ts",
    "db:backfill-food-links": "tsx scripts/backfill-food-links.ts",
    "db:backfill-nutrition": "tsx scripts/backfill-nutrition-cache.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.21",
    "@huggingface/transformers": "4.3.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tesseract.js-data/ara": "1.0.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "next-cloudinary": "^7.0.0",
    "next-intl": "4.14.9",
    "postgres": "^3.4.5",
    "posthog-js": "^1.438.24",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "7.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@jrmoulckers/eslint-config": ">=0.17.0 <1.0.0",
    "@next/bundle-analyzer": "^16.4.3",
    "@next/eslint-plugin-next": "^16.4.3",
    "@playwright/test": "^1.62.1",
    "@serwist/next": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "chrome-launcher": "^1.2.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.14.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "lighthouse": "^13.6.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serwist": "^9.5.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.6.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "esbuild",
      "msgpackr-extract",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "sharp": "^0.35.5",
      "next>postcss": "^8.5.18",
      "nanoid@^3": "^3.3.18",
      "browserslist": "^4.28.7",
      "brace-expansion": "^5.0.12",
      "ip-address": "^10.3.1",
      "js-yaml@^3": "^3.15.2",
      "js-yaml@^4": "^4.3.2",
      "@radix-ui/react-collection": "1.1.12",
      "tmp@<0.2.6": "^0.2.7",
      "onnxruntime-node>adm-zip": "^0.6.1",
      "jsdom>undici": "^8.12.3",
      "source-map-js@<1.2.2": "^1.2.2",
      "vite@>=7 <7.3.7": "^7.3.7",
      "dompurify@<3.4.17": "^3.4.17",
      "zod@>=4 <4.6.6": "^4.6.7"
    },
    "auditConfig": {
      "ignoreGhsas": []
    }
  }
}
