# Everything resolves from the public npm registry by default.
#
# This line is a no-op locally and in CI, because it restates pnpm's own
# default. It exists for Dependabot. Declaring a registry in `dependabot.yml`
# makes Dependabot treat it as the BASE registry when no global `registry=` is
# defined here, so every package -- not just the scoped ones -- gets routed to
# GitHub Packages. Its npm mirror is stale (it reports @types/react-dom@17.0.11
# as latest), so resolution then fails with ERR_PNPM_NO_MATCHING_VERSION on
# packages that have nothing to do with our scope. Naming the default
# explicitly keeps the override from happening (#1021).
#
# Do not delete this as "redundant". It is load-bearing for Dependabot only,
# which is exactly why nothing in local dev or CI will notice if it goes.
registry=https://registry.npmjs.org/

# Only the @jrmoulckers scope lives on GitHub Packages. Credentials are NOT set
# here: CI uses the per-job GITHUB_TOKEN, and Dependabot uses the token from its
# own secret store (see `.github/dependabot.yml`).
@jrmoulckers:registry=https://npm.pkg.github.com
